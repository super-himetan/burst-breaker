static func text(lang: String, key: String) -> String:
	var table: Dictionary = TEXT.get(lang, TEXT[DEFAULT_LANG])
	return String(table.get(key, TEXT[DEFAULT_LANG].get(key, key)))


## Shortens large values so they fit on small blocks: 1500 becomes 1.5K.
static func format_number(value: int) -> String:
	var units: Array[Array] = [[1.0e12, "T"], [1.0e9, "B"], [1.0e6, "M"], [1.0e3, "K"]]
	for unit in units:
		if absf(value) >= float(unit[0]):
			var scaled := value / float(unit[0])
			var digits := 0 if scaled >= 100.0 else 1
			return ("%.*f" % [digits, scaled]).trim_suffix(".0") + String(unit[1])
	return str(value)
